# Value of the "everybody-codes" cookie (devtools -> Application -> Cookies).
# It's a JWT that expires about a week after login; `make fetch` warns when it's close.
EC_TOKEN=

# Your account seed: the number in your input file's name (79.json -> 79).
EC_SEED=

# Cookie name. Only set this if the site ever renames it.
# EC_COOKIE=
